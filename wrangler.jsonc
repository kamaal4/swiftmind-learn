// Cloudflare Workers static-assets deploy of the `next build` export in out/.
// The only Worker code is the /admin editor's GitHub login (worker/sveltia-cms-auth.js);
// GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are dashboard secrets, not vars.
{
  "name": "swiftmind",
  "compatibility_date": "2026-10-01",
  "main": "./worker/sveltia-cms-auth.js",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/oauth/*"]
  },
  "vars": {
    // Only these sites may receive a token from the login popup. Same host as base_url in
    // public/admin/config.yml.
    "ALLOWED_DOMAINS": "swiftmind.ACCOUNT.workers.dev"
  }
}
